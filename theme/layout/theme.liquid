<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#26422B">

  <title>
    {%- if template == 'index' -%}
      {{ shop.name }}
    {%- elsif page_title == blank -%}
      {{ shop.name }}
    {%- else -%}
      {{ page_title }} — {{ shop.name }}
    {%- endif -%}
  </title>

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:title" content="{{ page_title | escape }}">
  {%- if page_description -%}
    <meta property="og:description" content="{{ page_description | escape }}">
  {%- endif -%}
  {%- if page_image -%}
    <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
  {%- endif -%}
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:type" content="website">

  <link rel="canonical" href="{{ canonical_url }}">

  <!-- Google Fonts: Cormorant Garamond (editorial serif) + Fredoka (logo) + DM Sans (body) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=DM+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Fredoka:wght@600;700&display=swap" rel="stylesheet">

  {{ content_for_header }}

  {{ 'theme.css' | asset_url | stylesheet_tag }}
</head>

<body class="template-{{ template | split: '.' | first }}">

  <!-- Announcement bar -->
  {%- if settings.announcement_text != blank -%}
    <div class="announcement-bar" role="banner">
      {{ settings.announcement_text }}
    </div>
  {%- endif -%}

  <!-- Header -->
  {%- section 'header' -%}

  <!-- Mobile nav -->
  <div class="nav-overlay" id="nav-overlay"></div>
  <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile navigation">
    {%- for link in linklists[settings.menu].links -%}
      <a href="{{ link.url }}" {% if link.active %}aria-current="page"{% endif %}>
        {{ link.title }}
      </a>
    {%- endfor -%}
  </nav>

  <!-- Cart drawer -->
  <div class="cart-overlay" id="cart-overlay"></div>
  <aside class="cart-drawer" id="cart-drawer" aria-label="Shopping cart">
    <div class="cart-header">
      <p class="cart-title">Your Bag ({{ cart.item_count }})</p>
      <button class="cart-close" id="cart-close" aria-label="Close cart">✕</button>
    </div>

    <div class="cart-body">
      {%- if cart.item_count == 0 -%}
        <p class="cart-empty">Your bag is empty.</p>
      {%- else -%}
        {%- for item in cart.items -%}
          <div class="cart-item">
            <a href="{{ item.url }}">
              <img
                class="cart-item-img"
                src="{{ item.image | image_url: width: 200 }}"
                alt="{{ item.image.alt | escape }}"
                width="80"
                height="107"
                loading="lazy"
              >
            </a>
            <div>
              <p class="cart-item-name">{{ item.product.title }}</p>
              <p class="cart-item-variant">{{ item.variant.title }}</p>
              <p class="cart-item-price">{{ item.final_price | money }}</p>
              <div class="cart-qty">
                <button class="qty-decrease" aria-label="Decrease">−</button>
                <span>{{ item.quantity }}</span>
                <button class="qty-increase" aria-label="Increase">+</button>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    <div class="cart-footer">
      <div class="cart-subtotal">
        <span class="cart-subtotal-label">Subtotal</span>
        <span class="cart-subtotal-price">{{ cart.total_price | money }}</span>
      </div>
      <a href="/checkout" class="cart-checkout-btn">Checkout</a>
    </div>
  </aside>

  <!-- Main content -->
  <main id="main-content" class="page-wrap" tabindex="-1">
    {{ content_for_layout }}
  </main>

  <!-- Footer -->
  {%- section 'footer' -%}

  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
