<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_forest }}">

  <title>
    {%- if template == 'index' -%}
      {{ shop.name }}
    {%- elsif page_title == blank -%}
      {{ shop.name }}
    {%- else -%}
      {{ page_title }} — {{ shop.name }}
    {%- endif -%}
  </title>

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  <meta property="og:site_name"  content="{{ shop.name }}">
  <meta property="og:title"      content="{{ page_title | escape }}">
  {%- if page_description -%}
    <meta property="og:description" content="{{ page_description | escape }}">
  {%- endif -%}
  {%- if page_image -%}
    <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
  {%- endif -%}
  <meta property="og:url"  content="{{ canonical_url }}">
  <meta property="og:type" content="website">

  <link rel="canonical" href="{{ canonical_url }}">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  <!-- Shopify-managed font faces (from Typography settings) -->
  {%- assign heading_font = settings.font_heading -%}
  {%- assign body_font    = settings.font_body -%}
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ body_font    | font_face: font_display: 'swap' }}

  <!-- Google Fonts fallback for Cormorant Garamond + Fredoka (logo) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=DM+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Fredoka:wght@600;700&display=swap" rel="stylesheet">

  {{ content_for_header }}

  {{ 'theme.css' | asset_url | stylesheet_tag }}

  <!-- Theme settings → CSS custom properties -->
  <!-- This block maps every color/font/spacing setting to a CSS variable,
       so changes in the Shopify Customizer take effect instantly site-wide. -->
  <style>
    :root {
      /* Brand colors — editable in Customizer → Colors */
      --forest:     {{ settings.color_forest }};
      --cream:      {{ settings.color_cream }};
      --sky:        {{ settings.color_sky }};
      --burgundy:   {{ settings.color_burgundy }};
      --terracotta: {{ settings.color_terracotta }};

      /* Derived tokens (computed from brand colors) */
      --bg:       {{ settings.color_cream }};
      --fg:       {{ settings.color_forest }};
      --mid-cream: color-mix(in srgb, {{ settings.color_forest }} 48%, transparent);
      --border:    color-mix(in srgb, {{ settings.color_forest }} 13%, transparent);

      /* Typography — editable in Customizer → Typography */
      --font-heading: {{ heading_font.family | default: 'Cormorant Garamond' }}, {{ heading_font.fallback_families | default: 'Georgia, serif' }};
      --font-body:    {{ body_font.family    | default: 'DM Sans' }},            {{ body_font.fallback_families    | default: 'Helvetica, Arial, sans-serif' }};
      --font-logo:    'Fredoka', sans-serif;
      --font-serif:   {{ heading_font.family | default: 'Cormorant Garamond' }}, {{ heading_font.fallback_families | default: 'Georgia, serif' }};

      /* Base font size */
      font-size: {{ settings.type_base_size }}px;

      /* Max page width — editable in Customizer → Spacing & layout */
      --max-w: {{ settings.page_width }};
    }

    /* Font-weight variants from Shopify font stack */
    .t-editorial,
    .t-display,
    .t-quote,
    .story-quote,
    .editorial-headline,
    .collection-banner-title,
    .product-title,
    .product-grid-title,
    .header-logo,
    h1, h2, h3 {
      font-family: var(--font-heading);
    }

    body,
    .t-label,
    .t-body,
    .t-small,
    .btn,
    .header-nav a,
    .header-actions a,
    .header-actions button {
      font-family: var(--font-body);
    }

    /* Disable animations if turned off in settings */
    {%- unless settings.animations_enabled -%}
    [data-animate] {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
    {%- endunless -%}
  </style>
</head>

<body class="template-{{ template | split: '.' | first }}">

  <!-- Announcement bar -->
  {%- if settings.announcement_enabled and settings.announcement_text != blank -%}
    <div class="announcement-bar" role="banner">
      {%- if settings.announcement_url != blank -%}
        <a href="{{ settings.announcement_url }}" style="color:inherit;">{{ settings.announcement_text }}</a>
      {%- else -%}
        {{ settings.announcement_text }}
      {%- endif -%}
    </div>
  {%- endif -%}

  <!-- Header -->
  {%- section 'header' -%}

  <!-- Mobile nav -->
  <div class="nav-overlay" id="nav-overlay"></div>
  <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile navigation">
    {%- for link in linklists[settings.menu].links -%}
      <a href="{{ link.url }}" {% if link.active %}aria-current="page"{% endif %}>
        {{ link.title }}
      </a>
    {%- endfor -%}
  </nav>

  <!-- Cart drawer -->
  {%- if settings.cart_type == 'drawer' -%}
    <div class="cart-overlay" id="cart-overlay"></div>
    <aside class="cart-drawer" id="cart-drawer" aria-label="Shopping cart">
      <div class="cart-header">
        <p class="cart-title">Your Bag ({{ cart.item_count }})</p>
        <button class="cart-close" id="cart-close" aria-label="Close cart">✕</button>
      </div>

      <div class="cart-body">
        {%- if cart.item_count == 0 -%}
          <p class="cart-empty">Your bag is empty.</p>
        {%- else -%}
          {%- for item in cart.items -%}
            <div class="cart-item">
              <a href="{{ item.url }}">
                <img
                  class="cart-item-img"
                  src="{{ item.image | image_url: width: 200 }}"
                  alt="{{ item.image.alt | escape }}"
                  width="80" height="107"
                  loading="lazy"
                >
              </a>
              <div>
                <p class="cart-item-name">{{ item.product.title }}</p>
                {%- unless item.variant.title == 'Default Title' -%}
                  <p class="cart-item-variant">{{ item.variant.title }}</p>
                {%- endunless -%}
                <p class="cart-item-price">{{ item.final_price | money }}</p>
                <div class="cart-qty">
                  <button class="qty-decrease" aria-label="Decrease">−</button>
                  <span>{{ item.quantity }}</span>
                  <button class="qty-increase" aria-label="Increase">+</button>
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>

      <div class="cart-footer">
        <div class="cart-subtotal">
          <span class="cart-subtotal-label">Subtotal</span>
          <span class="cart-subtotal-price">{{ cart.total_price | money }}</span>
        </div>
        <a href="/checkout" class="cart-checkout-btn">Checkout</a>
      </div>
    </aside>
  {%- endif -%}

  <!-- Main content -->
  <main id="main-content" class="page-wrap" tabindex="-1">
    {{ content_for_layout }}
  </main>

  <!-- Footer -->
  {%- section 'footer' -%}

  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
