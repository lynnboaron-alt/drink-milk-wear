<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }} — Coming Soon</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;1,400&family=DM+Sans:wght@400;600;700&family=Fredoka:wght@700&display=swap" rel="stylesheet">
  {{ content_for_header }}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <style>
    body {
      min-height: 100svh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: var(--forest);
      color: var(--cream);
      text-align: center;
      padding: var(--gap);
    }
    .pw-logo {
      font-family: var(--font-logo);
      font-size: 1.5rem;
      font-weight: 700;
      margin-bottom: clamp(2rem, 5vw, 4rem);
      letter-spacing: 0.01em;
    }
    .pw-headline {
      font-family: var(--font-serif);
      font-size: clamp(2.5rem, 8vw, 5rem);
      font-weight: 400;
      line-height: 1;
      margin-bottom: 1.5rem;
    }
    .pw-headline em { font-style: italic; color: rgba(249,245,230,0.55); }
    .pw-sub {
      font-family: var(--font-body);
      font-size: 0.875rem;
      color: rgba(249,245,230,0.55);
      margin-bottom: 3rem;
      max-width: 36ch;
      line-height: 1.65;
    }
    .pw-form {
      display: flex;
      border: 1.5px solid rgba(249,245,230,0.35);
      border-radius: 4px;
      overflow: hidden;
      max-width: 380px;
      width: 100%;
      margin: 0 auto 2.5rem;
    }
    .pw-input {
      flex: 1;
      background: transparent;
      border: none;
      color: var(--cream);
      font-family: var(--font-body);
      font-size: 0.875rem;
      padding: 0.875rem 1rem;
      outline: none;
    }
    .pw-input::placeholder { color: rgba(249,245,230,0.3); }
    .pw-btn {
      background: var(--terracotta);
      border: none;
      color: var(--cream);
      font-family: var(--font-body);
      font-size: 0.5625rem;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      padding: 0 1.25rem;
      cursor: pointer;
      transition: background 0.2s;
    }
    .pw-btn:hover { background: #bf4720; }
    .pw-enter {
      font-family: var(--font-body);
      font-size: 0.5625rem;
      font-weight: 600;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: rgba(249,245,230,0.35);
      margin-top: 1rem;
    }
    .pw-enter a {
      color: rgba(249,245,230,0.55);
      border-bottom: 1px solid currentColor;
      padding-bottom: 1px;
      transition: color 0.2s;
    }
    .pw-enter a:hover { color: var(--cream); }
  </style>
</head>
<body>
  <p class="pw-logo">DRINK MILK</p>

  <h1 class="pw-headline">
    Something cool<br><em>is coming.</em>
  </h1>

  <p class="pw-sub">
    Oversized essentials for little boys. Ages 1–6.<br>
    Sign up to be first when we drop.
  </p>

  {%- form 'customer', id: 'pw-newsletter' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <div class="pw-form">
      <input
        class="pw-input"
        type="email"
        name="contact[email]"
        placeholder="Your email address"
        autocomplete="email"
        required
      >
      <button class="pw-btn" type="submit">Notify Me</button>
    </div>
    {%- if form.posted_successfully? -%}
      <p style="color:rgba(249,245,230,0.6);font-size:0.75rem;font-family:var(--font-body);letter-spacing:0.1em;">
        You're in. We'll see you at drop time.
      </p>
    {%- endif -%}
  {%- endform -%}

  {%- if shop.password_message != blank -%}
    <p style="font-family:var(--font-body);font-size:0.75rem;color:rgba(249,245,230,0.4);max-width:40ch;line-height:1.65;">
      {{ shop.password_message }}
    </p>
  {%- endif -%}

  <p class="pw-enter">
    Store password:
    <a href="#" data-action="show-password">Enter here</a>
  </p>

  {{ content_for_layout }}
</body>
</html>
