<!-- Product page -->
<div class="container">
  <div class="product-layout">

    <!-- Gallery -->
    <div class="product-gallery">
      <div class="product-gallery-main">
        {%- if product.featured_image -%}
          <img
            class="gallery-main-img"
            src="{{ product.featured_image | image_url: width: 900 }}"
            srcset="{{ product.featured_image | image_url: width: 600 }} 600w,
                    {{ product.featured_image | image_url: width: 900 }} 900w"
            sizes="(max-width: 900px) 100vw, 50vw"
            alt="{{ product.featured_image.alt | default: product.title }}"
            width="{{ product.featured_image.width }}"
            height="{{ product.featured_image.height }}"
            loading="eager"
          >
        {%- else -%}
          <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:var(--sky);">
            <span style="font-size:0.5rem;font-weight:600;letter-spacing:0.2em;text-transform:uppercase;color:rgba(38,66,43,0.3);font-family:var(--font-body);">Product Image</span>
          </div>
        {%- endif -%}
      </div>

      {%- if product.images.size > 1 -%}
        <div class="product-gallery-thumbs">
          {%- for image in product.images -%}
            <button
              class="gallery-thumb {% if forloop.first %}active{% endif %}"
              data-src="{{ image | image_url: width: 900 }}"
              data-alt="{{ image.alt | escape }}"
              aria-label="View image {{ forloop.index }}"
            >
              <img
                src="{{ image | image_url: width: 150 }}"
                alt="{{ image.alt | escape }}"
                width="72"
                height="96"
                loading="lazy"
              >
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <!-- Info -->
    <div class="product-info">

      <p class="product-brand-tag">{{ product.type }}</p>
      <h1 class="product-title">{{ product.title }}</h1>

      <div class="product-price">
        {%- if product.compare_at_price > product.price -%}
          <s>{{ product.compare_at_price | money }}</s>
        {%- endif -%}
        {{ product.price | money }}
      </div>

      {%- form 'product', product, id: 'product-form' -%}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

        {%- for option in product.options_with_values -%}
          {%- if option.name == 'Size' or option.name == 'גיל' or option.name == 'Age' -%}
            <p class="product-option-label">
              <span>{{ option.name }}</span>
              <a href="#" style="opacity:0.5;font-weight:400;">Size Guide</a>
            </p>
            <div class="size-grid">
              {%- for value in option.values -%}
                {%- assign variant = product.variants | where: 'option1', value | first -%}
                <button
                  type="button"
                  class="size-btn {% if variant.available == false %}sold-out{% endif %}"
                  data-variant-id="{{ variant.id }}"
                  {% if variant.available == false %}disabled{% endif %}
                >
                  {{ value }}
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- endfor -%}

        <button
          type="submit"
          class="atc-btn"
          {% if product.selected_or_first_available_variant.available == false %}disabled{% endif %}
        >
          {%- if product.selected_or_first_available_variant.available -%}
            Add to Bag
          {%- else -%}
            Sold Out
          {%- endif -%}
        </button>

      {%- endform -%}

      <!-- Details accordion -->
      {%- if product.description != blank -%}
        <div class="accordion">
          <div class="accordion-item open">
            <button class="accordion-trigger">
              Details
              <span class="accordion-icon" aria-hidden="true"></span>
            </button>
            <div class="accordion-body">
              <div class="accordion-body-inner">{{ product.description }}</div>
            </div>
          </div>
          <div class="accordion-item">
            <button class="accordion-trigger">
              Fit & Sizing
              <span class="accordion-icon" aria-hidden="true"></span>
            </button>
            <div class="accordion-body">
              <div class="accordion-body-inner">
                <p>This piece is designed with an oversized, relaxed silhouette. We recommend sizing down if you prefer a closer fit, or staying true to size for the full dropped-shoulder look.</p>
              </div>
            </div>
          </div>
          <div class="accordion-item">
            <button class="accordion-trigger">
              Shipping &amp; Returns
              <span class="accordion-icon" aria-hidden="true"></span>
            </button>
            <div class="accordion-body">
              <div class="accordion-body-inner">
                <p>Free shipping on orders over ₪450. Orders are processed within 1–3 business days. Returns accepted within 14 days of delivery on unworn items.</p>
              </div>
            </div>
          </div>
        </div>
      {%- endif -%}

    </div>
  </div>
</div>

<!-- Related products -->
{%- assign related = collections[product.collections.first.handle].products | where: 'id', product.id | first -%}
{%- assign collection_products = collections[product.collections.first.handle].products -%}
{%- if collection_products.size > 1 -%}
  <section class="section-products" style="border-top:1px solid var(--border);">
    <div class="container">
      <div class="products-header">
        <p class="products-header-label">You Might Also Like</p>
      </div>
      <div class="product-grid">
        {%- for p in collection_products limit: 4 -%}
          {%- unless p.id == product.id -%}
            {%- render 'product-card', product: p -%}
          {%- endunless -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}
