<!-- Lookbook page -->

<!-- Header -->
<div class="lookbook-section">
  <div class="lookbook-header">
    <p class="editorial-label" style="justify-content:center;color:var(--burgundy);">SS26</p>
    <h1 class="editorial-headline" style="font-size:clamp(2.5rem,8vw,5rem);text-align:center;color:var(--forest);">The Drop</h1>
    <p style="font-family:var(--font-body);font-size:0.875rem;color:var(--mid-cream);margin-top:1rem;max-width:44ch;margin-inline:auto;text-align:center;">
      Oversized essentials. Premium cotton. Made for the kid who moves like the world is watching.
    </p>
  </div>

  <!-- Lookbook grid -->
  <div class="lookbook-grid">

    <div class="look-card look-main" data-animate>
      {%- if section.settings.image_1 != blank -%}
        <img src="{{ section.settings.image_1 | image_url: width: 1000 }}" alt="Look 1" loading="lazy">
      {%- else -%}
        <div style="width:100%;height:100%;background:var(--forest);display:flex;align-items:center;justify-content:center;">
          <span style="color:rgba(205,227,246,0.3);font-size:0.5rem;font-weight:600;letter-spacing:0.2em;text-transform:uppercase;font-family:var(--font-body);">Look 01</span>
        </div>
      {%- endif -%}
      <div class="look-card-overlay"><span class="look-card-label">Look 01</span></div>
    </div>

    <div class="look-side">
      <div class="look-card" data-animate data-animate-delay="1">
        {%- if section.settings.image_2 != blank -%}
          <img src="{{ section.settings.image_2 | image_url: width: 700 }}" alt="Look 2" loading="lazy">
        {%- else -%}
          <div style="width:100%;height:100%;background:var(--sky);display:flex;align-items:center;justify-content:center;">
            <span style="color:rgba(38,66,43,0.3);font-size:0.5rem;font-weight:600;letter-spacing:0.2em;text-transform:uppercase;font-family:var(--font-body);">Look 02</span>
          </div>
        {%- endif -%}
        <div class="look-card-overlay"><span class="look-card-label">Look 02</span></div>
      </div>
      <div class="look-card" data-animate data-animate-delay="2">
        {%- if section.settings.image_3 != blank -%}
          <img src="{{ section.settings.image_3 | image_url: width: 700 }}" alt="Look 3" loading="lazy">
        {%- else -%}
          <div style="width:100%;height:100%;background:var(--burgundy);display:flex;align-items:center;justify-content:center;">
            <span style="color:rgba(249,245,230,0.3);font-size:0.5rem;font-weight:600;letter-spacing:0.2em;text-transform:uppercase;font-family:var(--font-body);">Look 03</span>
          </div>
        {%- endif -%}
        <div class="look-card-overlay"><span class="look-card-label">Look 03</span></div>
      </div>
    </div>

    <div class="look-row">
      {%- for i in (4..6) -%}
        {%- assign img_key = 'image_' | append: i -%}
        <div class="look-card" data-animate data-animate-delay="{{ forloop.index }}">
          {%- if section.settings[img_key] != blank -%}
            <img src="{{ section.settings[img_key] | image_url: width: 700 }}" alt="Look {{ i }}" loading="lazy">
          {%- else -%}
            <div style="width:100%;height:100%;background:var(--cream);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;">
              <span style="color:rgba(38,66,43,0.3);font-size:0.5rem;font-weight:600;letter-spacing:0.2em;text-transform:uppercase;font-family:var(--font-body);">Look 0{{ i }}</span>
            </div>
          {%- endif -%}
          <div class="look-card-overlay"><span class="look-card-label">Look 0{{ i }}</span></div>
        </div>
      {%- endfor -%}
    </div>

  </div>
</div>

<!-- Shop the look CTA -->
<section class="section-collection-banner" style="margin-top:3rem;">
  <p class="collection-banner-title">Shop the <em>full collection.</em></p>
  <a href="/collections/all" class="collection-banner-link">View All Pieces</a>
</section>

{% schema %}
{
  "name": "Lookbook",
  "settings": [
    { "type": "image_picker", "id": "image_1", "label": "Look 1 (large)" },
    { "type": "image_picker", "id": "image_2", "label": "Look 2" },
    { "type": "image_picker", "id": "image_3", "label": "Look 3" },
    { "type": "image_picker", "id": "image_4", "label": "Look 4" },
    { "type": "image_picker", "id": "image_5", "label": "Look 5" },
    { "type": "image_picker", "id": "image_6", "label": "Look 6" }
  ]
}
{% endschema %}
