<!-- Generic page -->
<div class="container" style="padding-block:clamp(3rem,7vw,6rem);max-width:760px;">
  <h1 style="font-family:var(--font-serif);font-size:clamp(2rem,5vw,3.5rem);font-weight:400;color:var(--forest);margin-bottom:2rem;line-height:1.05;">
    {{ page.title }}
  </h1>
  <div class="rte" style="font-family:var(--font-body);font-size:0.9375rem;color:var(--mid-cream);line-height:1.75;">
    {{ page.content }}
  </div>
</div>
