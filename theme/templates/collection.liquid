<!-- Collection page -->
<div class="collection-hero">
  <h1 class="collection-hero-title">{{ collection.title }}</h1>
  {%- if collection.description != blank -%}
    <p class="collection-hero-desc">{{ collection.description }}</p>
  {%- endif -%}
</div>

<div class="collection-grid-section">
  <div class="container">

    <!-- Toolbar -->
    <div class="collection-toolbar">
      <div class="filter-group" role="group" aria-label="Filter by">
        <button class="filter-chip active">All</button>
        <button class="filter-chip">Tops</button>
        <button class="filter-chip">Pants</button>
        <button class="filter-chip">Sets</button>
      </div>
      <p style="font-family:var(--font-body);font-size:0.5625rem;font-weight:600;letter-spacing:0.14em;text-transform:uppercase;color:var(--mid-cream);">
        {{ collection.products_count }} piece{%- if collection.products_count != 1 -%}s{%- endif -%}
      </p>
    </div>

    <!-- Grid -->
    {%- paginate collection.products by 12 -%}
      <div class="product-grid">
        {%- for product in collection.products -%}
          {%- render 'product-card', product: product -%}
        {%- else -%}
          <p style="grid-column:1/-1;text-align:center;padding:3rem;font-family:var(--font-body);color:var(--mid-cream);">No products found.</p>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <div style="display:flex;justify-content:center;gap:0.5rem;margin-top:3rem;">
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}" style="padding:0.5rem 0.875rem;border:1.5px solid var(--border);font-size:0.6875rem;font-family:var(--font-body);">{{ part.title }}</a>
            {%- else -%}
              <span style="padding:0.5rem 0.875rem;border:1.5px solid var(--forest);background:var(--forest);color:var(--cream);font-size:0.6875rem;font-family:var(--font-body);">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endpaginate -%}

  </div>
</div>
