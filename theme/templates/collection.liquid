<!-- Collection page — curated drop, editorial 2-col presentation -->

<!-- Intro header: title + count + description -->
<div class="collection-intro">
  <div class="collection-intro-left">
    <p class="collection-intro-label">SS26 Drop</p>
    <h1 class="collection-intro-title">{{ collection.title | replace: 'Collection', '' | strip }}</h1>
  </div>
  <div class="collection-intro-right">
    <p class="collection-intro-count">{{ collection.products_count }} pieces</p>
    {%- if collection.description != blank -%}
      <p class="collection-intro-desc">{{ collection.description }}</p>
    {%- else -%}
      <p class="collection-intro-desc">Oversized essentials. Premium cotton. Built for little boys who move like the world is watching.</p>
    {%- endif -%}
  </div>
</div>

<!-- Editorial grid: all products, staggered, 2-col desktop / 1-col mobile -->
<div class="collection-editorial-grid">

  {%- assign tops    = collection.products | where: 'type', 'Tops' -%}
  {%- assign pants   = collection.products | where: 'type', 'Pants' -%}
  {%- assign has_types = false -%}
  {%- if tops.size > 0 and pants.size > 0 -%}
    {%- assign has_types = true -%}
  {%- endif -%}

  {%- if has_types -%}

    <!-- Tops category divider -->
    <div class="collection-category-divider">
      <span class="collection-category-divider-label">Tops</span>
    </div>

    {%- for product in tops -%}
      {%- render 'product-card', product: product -%}
    {%- endfor -%}

    <!-- Pants category divider -->
    <div class="collection-category-divider" style="margin-top:clamp(1rem,3vw,2rem);">
      <span class="collection-category-divider-label">Pants</span>
    </div>

    {%- for product in pants -%}
      {%- render 'product-card', product: product -%}
    {%- endfor -%}

  {%- else -%}

    {%- for product in collection.products -%}
      {%- render 'product-card', product: product -%}
    {%- else -%}
      <p style="grid-column:1/-1;text-align:center;padding:4rem 0;font-family:var(--font-body);color:var(--mid-cream);font-size:0.875rem;">
        The drop is coming. Sign up below to be first.
      </p>
    {%- endfor -%}

  {%- endif -%}

</div>

<!-- Bottom CTA: story / newsletter pull-down -->
<div style="background:var(--cream);padding:clamp(2.5rem,6vw,5rem) var(--gap);border-top:1px solid var(--border);text-align:center;">
  <p style="font-family:var(--font-body);font-size:0.5625rem;font-weight:700;letter-spacing:0.25em;text-transform:uppercase;color:var(--mid-cream);margin-bottom:1.25rem;">
    The Drink Milk Way
  </p>
  <p class="t-editorial" style="color:var(--forest);margin-bottom:2rem;">
    Raised wild.<br><em>Dressed good.</em>
  </p>
  <a href="/pages/about" class="btn btn-outline-forest">Our Story</a>
</div>
