<!-- Featured products: editorial 2×2 grid — 4 key pieces from the drop -->
<section class="section-products">
  <div class="container">

    <div class="products-header">
      <p class="products-header-label">{{ section.settings.label }}</p>
      {%- if section.settings.view_all_label != blank -%}
        <a
          href="{{ section.settings.collection.url | default: '/collections/all' }}"
          class="products-header-link"
        >
          {{ section.settings.view_all_label }}
        </a>
      {%- endif -%}
    </div>

    <div class="product-grid">
      {%- if section.settings.collection != blank -%}
        {%- for product in section.settings.collection.products limit: 4 -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Placeholder cards when no collection is selected {%- endcomment -%}
        {%- assign placeholder_items = 'Burgundy Oversized Tee,Cream Balloon Tee,Forest Wide-Leg Pants,Washed Blue Wide Pants' | split: ',' -%}
        {%- assign placeholder_cats = 'Tops · Ages 1–2,Tops · Ages 2–3,Pants · Ages 3–4,Pants · Ages 5–6' | split: ',' -%}
        {%- assign placeholder_prices = '₪159,₪159,₪199,₪199' | split: ',' -%}
        {%- assign placeholder_bgs = 'var(--burgundy),var(--cream),var(--forest),var(--sky)' | split: ',' -%}
        {%- for item in placeholder_items -%}
          <div class="product-grid-item">
            <div
              class="product-grid-media"
              style="display:flex;align-items:center;justify-content:center;background:{{ placeholder_bgs[forloop.index0] }};"
            >
              <span style="font-size:0.5rem;font-weight:600;letter-spacing:0.2em;text-transform:uppercase;color:rgba(249,245,230,0.3);font-family:var(--font-body);">Product Image</span>
            </div>
            <p class="product-grid-category">{{ placeholder_cats[forloop.index0] }}</p>
            <p class="product-grid-title">{{ item }}</p>
            <div class="product-grid-bottom">
              <span class="product-grid-price">{{ placeholder_prices[forloop.index0] }}</span>
              <button class="product-grid-add">Add</button>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section label",
      "default": "Best Sellers"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all text",
      "default": "View All"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection to pull from"
    }
  ],
  "presets": [
    { "name": "Featured Products" }
  ]
}
{% endschema %}
