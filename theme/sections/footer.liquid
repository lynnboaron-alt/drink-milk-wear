<!-- Footer: burgundy, minimal.
     Social links come from global Theme Settings → Social media,
     so they only need to be set in one place. -->
<footer class="site-footer" role="contentinfo">
  <div class="footer-inner container">

    <!-- Logo or wordmark -->
    {%- if settings.logo != blank -%}
      <a href="/" class="footer-logo" aria-label="{{ shop.name }}">
        <img
          src="{{ settings.logo | image_url: width: 160 }}"
          alt="{{ shop.name }}"
          width="80"
          loading="lazy"
          style="filter:brightness(0) invert(1);opacity:0.9;"
        >
      </a>
    {%- else -%}
      <a href="/" class="footer-logo">DRINK MILK</a>
    {%- endif -%}

    <nav class="footer-links-row" aria-label="Footer navigation">
      {%- for link in linklists[section.settings.menu].links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    </nav>

    <!-- Social from global settings -->
    <div class="footer-social">
      {%- if settings.instagram_url != blank -%}
        <a href="{{ settings.instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram">
          Instagram
        </a>
      {%- endif -%}
      {%- if settings.tiktok_url != blank -%}
        <a href="{{ settings.tiktok_url }}" target="_blank" rel="noopener" aria-label="TikTok">
          TikTok
        </a>
      {%- endif -%}
      {%- if settings.pinterest_url != blank -%}
        <a href="{{ settings.pinterest_url }}" target="_blank" rel="noopener" aria-label="Pinterest">
          Pinterest
        </a>
      {%- endif -%}
    </div>

  </div>

  <div class="footer-bottom container">
    <p class="footer-copy">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
    <div class="payment-icons">
      {%- for type in shop.enabled_payment_types -%}
        {{ type | payment_type_svg_tag: class: 'payment-icon' }}
      {%- endfor -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Footer menu",
      "default": "footer",
      "info": "Social media links are set under Theme Settings → Social media."
    }
  ]
}
{% endschema %}
