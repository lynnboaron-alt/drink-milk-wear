<!-- Newsletter: sky blue section, "Made for milk lovers." -->
<section class="section-newsletter">

  <h2 class="newsletter-title" data-animate>{{ section.settings.title }}</h2>

  {%- if section.settings.subtitle != blank -%}
    <p class="newsletter-sub" data-animate data-animate-delay="1">{{ section.settings.subtitle }}</p>
  {%- endif -%}

  {%- form 'customer', id: 'newsletter-form', data-animate: '', data-animate-delay: '2' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <div class="newsletter-form">
      <input
        class="newsletter-input"
        type="email"
        name="contact[email]"
        placeholder="{{ section.settings.placeholder }}"
        autocomplete="email"
        required
      >
      <button class="newsletter-btn" type="submit" aria-label="Subscribe">→</button>
    </div>
    {%- if form.posted_successfully? -%}
      <p style="color:var(--mid-cream);font-size:0.75rem;margin-top:1rem;letter-spacing:0.1em;font-family:var(--font-body);">
        {{ section.settings.success_message }}
      </p>
    {%- endif -%}
  {%- endform -%}

</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Made for milk lovers."
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Be the first to know about new collections and exclusive offers."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "You're in. Welcome to the family."
    }
  ],
  "presets": [
    { "name": "Newsletter" }
  ]
}
{% endschema %}
