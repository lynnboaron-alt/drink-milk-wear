<header class="site-header" role="banner">
  <div class="container">
    <div class="header-inner">

      <!-- Hamburger — left slot -->
      <button
        class="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open navigation"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>

      <!-- Logo — center slot -->
      <a href="/" class="header-logo" aria-label="{{ shop.name }} — Home">
        {%- if settings.logo != blank -%}
          <img
            src="{{ settings.logo | image_url: width: settings.logo_width }}"
            srcset="{{ settings.logo | image_url: width: settings.logo_width }} 1x,
                    {{ settings.logo | image_url: width: settings.logo_width | times: 2 }} 2x"
            alt="{{ shop.name }}"
            width="{{ settings.logo_width }}"
            height="{{ settings.logo_width | divided_by: settings.logo.aspect_ratio | round }}"
            loading="eager"
          >
        {%- else -%}
          DRINK MILK
        {%- endif -%}
      </a>

      <!-- Actions — right slot -->
      <div class="header-actions">
        <a href="/search" aria-label="Search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
          </svg>
        </a>

        {%- if settings.cart_type == 'drawer' -%}
          <button data-cart-trigger aria-label="Open cart — {{ cart.item_count }} items">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
              <line x1="3" y1="6" x2="21" y2="6"/>
              <path d="M16 10a4 4 0 0 1-8 0"/>
            </svg>
            {%- if cart.item_count > 0 -%}
              <span class="cart-count" aria-hidden="true">{{ cart.item_count }}</span>
            {%- endif -%}
          </button>
        {%- else -%}
          <a href="/cart" aria-label="Cart — {{ cart.item_count }} items">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
              <line x1="3" y1="6" x2="21" y2="6"/>
              <path d="M16 10a4 4 0 0 1-8 0"/>
            </svg>
            {%- if cart.item_count > 0 -%}
              <span class="cart-count" aria-hidden="true">{{ cart.item_count }}</span>
            {%- endif -%}
          </a>
        {%- endif -%}
      </div>

    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
